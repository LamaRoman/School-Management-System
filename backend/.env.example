# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/nepali_report_card?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=4000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:3000"

# Default password assigned to auto-created student accounts (change in production)
DEFAULT_STUDENT_PASSWORD="student123"

# Public school website — notified after gallery/notice changes so it can
# revalidate its cache instantly instead of waiting for a time-based refresh.
WEBSITE_URL="http://localhost:3002"
WEBSITE_REVALIDATE_SECRET="change-me"

# Origins allowed to call the unauthenticated /public/* routes (comma-separated)
PUBLIC_CORS_ORIGINS="http://localhost:3002"
