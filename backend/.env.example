# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/nepali_report_card?schema=public"

# JWT — MUST be a strong, random value of at least 32 characters.
# The server refuses to start in production if this is left as the placeholder
# below or is shorter than 32 chars. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=4000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:3000"

# Default password assigned to auto-created student accounts (change in production)
DEFAULT_STUDENT_PASSWORD="student123"

# Calendarific holidays API — used by super-admin master calendar to import
# Nepal's national holidays. Get a key at https://calendarific.com/
CALENDARIFIC_API_KEY="your-calendarific-api-key"

# Each school's public website URL + revalidation secret are configured
# per-school (School.websiteUrl / websiteRevalidateSecret, set via the
# super-admin school editor) rather than as env vars here — a school's
# website is automatically allowed to call /public/* and gets revalidation
# webhooks once its URL is registered.
